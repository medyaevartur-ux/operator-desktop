{
  "name": "zhivaya-chat-api",
  "version": "8.0.0-beta.4",
  "type": "module",
  "description": "Alphabet Chat API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node scripts/migrate.mjs",
    "test:unit": "node --import tsx --test test/policy.test.mjs",
    "test:integration": "node scripts/bootstrap-test-db.mjs && node --import tsx --test test/integration.test.mjs",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "firebase-admin": "^14.4.0",
    "pg": "^8.20.0",
    "semver": "^7.8.5",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/semver": "^7.8.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "gaxios@^6": {
      "uuid": "^11.1.1"
    },
    "tsx": {
      "esbuild": "^0.28.2"
    }
  }
}
