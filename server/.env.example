PORT=3010
HOST=127.0.0.1
DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=https://zhivaya-skazka.ru,https://operator.zhivaya-skazka.ru,http://tauri.localhost,https://tauri.localhost,tauri://localhost
PUBLIC_ORIGIN=https://zhivaya-skazka.ru
PRIVATE_UPLOAD_DIR=
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30
PUSH_DRY_RUN=false
FIREBASE_SERVICE_ACCOUNT_PATH=
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Вложения чата: local — диск сервера (PRIVATE_UPLOAD_DIR), s3 — бакет Timeweb. Ключи — только в .env.chat-v8 на сервере.
CHAT_FILE_STORE=local
CHAT_S3_ENDPOINT=https://s3.twcstorage.ru
CHAT_S3_REGION=ru-1
CHAT_S3_BUCKET=
CHAT_S3_PREFIX=chat-v8/
CHAT_S3_ACCESS_KEY=
CHAT_S3_SECRET_KEY=
OPERATOR_UPDATES_DIR=/var/www/updates/operator-desktop
